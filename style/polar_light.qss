/**
 * @file polar_light.qss
 * @brief Qt stylesheet for the Game Boy emulator UI (light).
 *
 * This is one of several interchangeable themes; the active one is selected in
 * the settings dialog (Settings > Appearance > Theme).
 */

QMainWindow {
    background-color: #eef1f5;
}

QMenuBar {
    background-color: #ffffff;
    color: #2d3748;
    border-bottom: 1px solid #c3ccd8;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
}

QMenuBar::item:selected {
    background-color: #4f93de;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    color: #2d3748;
    border: 1px solid #c3ccd8;
}

QMenu::item {
    padding: 4px 24px 4px 8px;
}

QMenu::item:selected {
    background-color: #4f93de;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #c3ccd8;
    margin: 4px 0px;
}

QToolBar {
    background-color: #ffffff;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolButton {
    background-color: #e2e7ee;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    border-radius: 3px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #5196eb;
}

QToolButton:pressed {
    background-color: #1f63b8;
}

QToolButton:checked {
    background-color: #4f93de;
}

QStatusBar {
    background-color: #ffffff;
    color: #2d3748;
    border-top: 1px solid #c3ccd8;
}

QLabel {
    color: #2d3748;
}

QLabel#libraryTitle {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#librarySubtitle {
    color: #66748a;
}

QLabel#libraryDetail {
    color: #2d3748;
    padding: 6px;
    background-color: #ffffff;
    border: 1px solid #c3ccd8;
    border-radius: 4px;
}

QPushButton {
    background-color: #e2e7ee;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    border-radius: 4px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #5196eb;
}

QPushButton:pressed {
    background-color: #1f63b8;
}

QPushButton:disabled {
    color: #66748a;
    background-color: #ffffff;
}

QPushButton#primaryButton {
    background-color: #2c7be4;
    color: #ffffff;
    border: 1px solid #1f63b8;
    border-radius: 4px;
    font-weight: bold;
    padding: 6px 18px;
}

QPushButton#primaryButton:hover {
    background-color: #5196eb;
}

QPushButton#primaryButton:pressed {
    background-color: #1f63b8;
}

QDockWidget::title {
    background-color: #ffffff;
    color: #2d3748;
    padding: 4px;
    border: 1px solid #c3ccd8;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: #e2e7ee;
    border: 1px solid #c3ccd8;
    border-radius: 2px;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #5196eb;
}

QListWidget {
    background-color: #eef1f5;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    border-radius: 4px;
    outline: 0;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #4f93de;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #3c7fce;
}

QListWidget::item:alternate {
    background-color: #e2e7ee;
}

QTableWidget {
    background-color: #eef1f5;
    color: #2d3748;
    gridline-color: #ffffff;
    border: 1px solid #c3ccd8;
    selection-background-color: #4f93de;
}

QTableWidget::item {
    padding: 2px 4px;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #2d3748;
    padding: 4px;
    border: 1px solid #c3ccd8;
}

QPlainTextEdit {
    background-color: #eef1f5;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    selection-background-color: #4f93de;
    font-family: "Consolas", "Courier New", monospace;
}

QTabWidget::pane {
    border: 1px solid #c3ccd8;
    background-color: #eef1f5;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #ffffff;
    color: #66748a;
    padding: 6px 14px;
    border: 1px solid #c3ccd8;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #4f93de;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e7ee;
}

QGroupBox {
    border: 1px solid #c3ccd8;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 8px;
    color: #2d3748;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QComboBox {
    background-color: #e2e7ee;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox:hover {
    background-color: #5196eb;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2d3748;
    border: 1px solid #c3ccd8;
    selection-background-color: #4f93de;
}

QSlider::groove:horizontal {
    background-color: #ffffff;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #2c7be4;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #5196eb;
}

QScrollBar:vertical {
    background-color: #eef1f5;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #e2e7ee;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5196eb;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #eef1f5;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #e2e7ee;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5196eb;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QDialog {
    background-color: #eef1f5;
}

/* LCD bezel behind the screen widget (global action area of the game window). */
QFrame#lcdFrame {
    background-color: #ffffff;
    border: 1px solid #c3ccd8;
    border-radius: 6px;
}

/* Document the capture buttons of the settings dialog. */
QPushButton:focus {
    border: 1px solid #2c7be4;
}

/* Checkable menu actions keep a visible check mark. */
QMenu::indicator {
    width: 12px;
    height: 12px;
}

/* Toolbar separators look lighter than the dark background. */
QToolBar::separator {
    background-color: #c3ccd8;
    width: 1px;
    margin: 3px 4px;
}

/* Status bar labels are left aligned and spaced. */
QStatusBar QLabel {
    padding: 0 6px;
}
