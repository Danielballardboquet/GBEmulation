        <file>style/dark_cobalt.qss</file>
        <file>style/dark_purple.qss</file>
        <file>style/gb_classic.qss</file>
        <file>style/neon.qss</file>
        <file>style/polar_light.qss</file>
        <file>data/games_database.json</file>
    </qresource>
</RCC>
